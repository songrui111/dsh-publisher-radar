{
  "name": "dsh-publisher-radar",
  "version": "1.0.1",
  "description": "Market-gap radar for DSH plugin developers: splits 6,000+ plugins by category and topic, tags each topic empty / thin / contested / crowded, and ranks the emptiest directions first — so you know what to build before writing it. Also browses the full market with copy-ready install commands. · 面向 DSH 插件开发者的市场空白雷达：把 6,000+ 插件按大类拆到方向，每档标出空位/稀少/有竞争/红海，空位最多的方向排前面——动手前先知道该做什么；市场全量浏览与安装命令作为附带能力。",
  "type": "module",
  "main": "index.js",
  "author": "宋锐 <2047751661@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/songrui111/dsh-publisher-radar.git"
  },
  "homepage": "https://github.com/songrui111/dsh-publisher-radar#readme",
  "bugs": {
    "url": "https://github.com/songrui111/dsh-publisher-radar/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.2"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/host.mjs && node test/client.mjs",
    "test:live": "node test/smoke.mjs --catalog ../market/plugins.json && node test/host.mjs --catalog ../market/plugins.json",
    "test:install": "npm pack --silent && node test/install.mjs",
    "sync": "node scripts/sync.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin-market",
    "market-intelligence",
    "discovery",
    "publisher",
    "plugin-author"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
